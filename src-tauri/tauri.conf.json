{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaifuDesk",
  "version": "0.1.0",
  "identifier": "com.waifujahat.waifudesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WaifuDesk",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 930,
        "minHeight": 650,
        "backgroundColor": "#0c1021",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/waifudesk-api"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}