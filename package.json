{
  "name": "waifudesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "node scripts/prepare-sidecar.mjs && npm run dev",
    "desktop:build": "node scripts/prepare-sidecar.mjs --release && npm run build",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src eslint.config.mjs vite.config.ts",
    "format:check": "prettier --check src eslint.config.mjs vite.config.ts",
    "verify": "npm run lint && npm run format:check && npm run build && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.0",
    "vitest": "5.0.5"
  }
}
